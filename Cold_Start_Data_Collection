function d = decodeStim093(packet)
    packet = uint8(packet);
    d.dgid = packet(1);
    
    d.gyro_x = convert24(packet(2:4))  / 2^14;
    d.gyro_y = convert24(packet(5:7))  / 2^14;
    d.gyro_z = convert24(packet(8:10)) / 2^14;
    
    % bytes 12-20 are accel XYZ for standard STIM318 0x93
    d.acc_x = convert24(packet(12:14)) / 2^19;
    d.acc_y = convert24(packet(15:17)) / 2^19;
    d.acc_z = convert24(packet(18:20)) / 2^19;
    
    d.crc_rx = uint32(packet(35)) * 2^24 + uint32(packet(36)) * 2^16 + uint32(packet(37)) * 2^8  + uint32(packet(38));
    crcInput = [packet(1:34), uint8([0 0])];
    d.crc_calc = stim_crc32(crcInput);
    d.crc_ok = isequal(d.crc_rx, d.crc_calc);
end

function y = convert24(b)
    raw = double(b(1)) * 2^16 + double(b(2)) * 2^8 + double(b(3));
    if raw >= 2^23, y = raw - 2^24; else, y = raw; end
end

function crc = stim_crc32(data)
    data = uint8(data);
    poly = uint32(hex2dec("04C11DB7"));
    crc  = uint32(hex2dec("FFFFFFFF"));
    for i = 1:numel(data)
        crc = bitxor(crc, bitshift(uint32(data(i)), 24));
        for bitNo = 1:8
            if bitand(crc, uint32(hex2dec("80000000"))) ~= 0
                crc = bitxor(bitshift(crc, 1), poly);
            else
                crc = bitshift(crc, 1);
            end
        end
    end
end
