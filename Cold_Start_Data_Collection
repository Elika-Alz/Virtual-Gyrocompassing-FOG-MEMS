%% 5-min cold start data collection (FOG + STIM)
% Also extracts accelerometer data for virtual leveling later.

function Cold_Start_Data_Collection()
    clc;
    
    %% Configs
    port_FOG = "COM6";   
    port_STIM = "COM7";  
    baudRate = 921600;
    
    totalHours = 10 / 60;      % 5 mins total
    chunkMinutes = 10;         % save everything in one chunk
    
    totalSeconds = totalHours * 3600;
    chunkSeconds = chunkMinutes * 60;
    
    %% Init ports
    disp('Opening serial ports...');
    try
        s_fog = serialport(port_FOG, baudRate, "Timeout", 1);
        s_stim = serialport(port_STIM, baudRate, "DataBits", 8, "Parity", "none", "StopBits", 1, "FlowControl", "none", "Timeout", 1);
    catch
        error('Failed to open COM ports. Check cables.');
    end
    
    flush(s_fog); flush(s_stim);
    
    STIM_DGID = uint8(hex2dec("93"));
    STIM_DG_LENGTH = 38;
    FOG_DG_LENGTH = 39;

    maxSamples_FOG = chunkSeconds * 150;   
    maxSamples_STIM = chunkSeconds * 2500; 
    
    buffer_FOG = uint8([]);
    buffer_STIM = uint8([]);
    
    disp('Starting 5-min log... DO NOT TOUCH THE TABLE');
    
    total_tic = tic;
    chunk_index = 1;
    
    while toc(total_tic) < totalSeconds
        
        navDataArray = zeros(maxSamples_FOG, 9);
        stimDataArray = zeros(maxSamples_STIM, 7); % Time, gX, gY, gZ, aX, aY, aZ
        navRawArray = zeros(maxSamples_FOG, FOG_DG_LENGTH, 'uint8');
        stimRawArray = zeros(maxSamples_STIM, STIM_DG_LENGTH, 'uint8');
        
        count_FOG = 1;
        count_STIM = 1;
        
        chunk_tic = tic;
        
        while toc(chunk_tic) < chunkSeconds && toc(total_tic) < totalSeconds
            
            % -- FOG loop --
            n_fog = s_fog.NumBytesAvailable;
            if n_fog > 0
                buffer_FOG = [buffer_FOG, reshape(read(s_fog, n_fog, "uint8"), 1, [])]; %#ok<AGROW>
            end
            
            while length(buffer_FOG) >= FOG_DG_LENGTH
                if buffer_FOG(1) == hex2dec('5A') && buffer_FOG(2) == hex2dec('55') && buffer_FOG(FOG_DG_LENGTH) == hex2dec('0A')
                    packet = buffer_FOG(1:FOG_DG_LENGTH);
                    calculatedCRC = calculate_crc16_ccitt(packet(1:36));
                    receivedCRC = bitor(bitshift(uint16(packet(37)), 8), uint16(packet(38)));
                    
                    if calculatedCRC == receivedCRC
                        da_x = typecast(packet(3:6), 'single'); da_y = typecast(packet(7:10), 'single'); da_z = typecast(packet(11:14), 'single');
                        dv_x = typecast(packet(15:18), 'single'); dv_y = typecast(packet(19:22), 'single'); dv_z = typecast(packet(23:26), 'single');
                        master_bit = typecast(packet(31:34), 'uint32'); counter = typecast(packet(35:36), 'uint16');
                        
                        navDataArray(count_FOG, :) = [toc(total_tic), da_x, da_y, da_z, dv_x, dv_y, dv_z, double(master_bit), double(counter)];
                        navRawArray(count_FOG, :) = packet;
                        count_FOG = count_FOG + 1;
                    end
                    buffer_FOG(1:FOG_DG_LENGTH) = [];
                else
                    buffer_FOG(1) = [];
                end
            end
            
            % -- STIM318 loop --
            n_stim = s_stim.NumBytesAvailable;
            if n_stim > 0
                buffer_STIM = [buffer_STIM, reshape(read(s_stim, n_stim, "uint8"), 1, [])]; %#ok<AGROW>
            end
            
            while length(buffer_STIM) >= STIM_DG_LENGTH
                idx = find(buffer_STIM == STIM_DGID, 1, "first");
                if isempty(idx), buffer_STIM = uint8([]); break; end
                if idx > 1, buffer_STIM = buffer_STIM(idx:end); end
                if length(buffer_STIM) < STIM_DG_LENGTH, break; end
                
                packet = buffer_STIM(1:STIM_DG_LENGTH);
                decoded = decodeStim093(packet);
                
                if decoded.crc_ok
                    stimDataArray(count_STIM, :) = [toc(total_tic), decoded.gyro_x, decoded.gyro_y, decoded.gyro_z, decoded.acc_x, decoded.acc_y, decoded.acc_z];
                    stimRawArray(count_STIM, :) = packet;
                    count_STIM = count_STIM + 1;
                    buffer_STIM(1:STIM_DG_LENGTH) = [];
                else
                    buffer_STIM(1) = [];
                end
            end
        end
        
        % trim empty rows
        navDataArray = navDataArray(1:count_FOG-1, :);
        stimDataArray = stimDataArray(1:count_STIM-1, :);
        navRawArray = navRawArray(1:count_FOG-1, :);
        stimRawArray = stimRawArray(1:count_STIM-1, :);
        
        % fix timestamps
        if ~isempty(navDataArray)
            startTime = navDataArray(1, 1);
            navDataArray(:, 1) = startTime + (0:(size(navDataArray, 1)-1))' * (1/100); 
        end
        
        timestamp = char(datetime('now', 'Format', 'yyyyMMdd_HHmm'));
        filename_mat = sprintf('IMU_COLDSTART_%s.mat', timestamp);
        
        save(filename_mat, 'navDataArray', 'stimDataArray', 'navRawArray', 'stimRawArray');
        fprintf('Saved: %s (FOG: %d, STIM: %d samples)\n', filename_mat, size(navDataArray,1), size(stimDataArray,1));
        
        chunk_index = chunk_index + 1;
    end
    
    clear s_fog s_stim;
    disp('Done collecting data.');
end

